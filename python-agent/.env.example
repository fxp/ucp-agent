# ── LLM ──────────────────────────────────────────────────────────────────────
GLM_API_KEY=your_glm_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash

# ── LangSmith Observability ───────────────────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ucp-vending-agent
# LANGSMITH_ENABLED=true   # set false to disable tracing in dev

# ── UCP Mock Server ───────────────────────────────────────────────────────────
UCP_MOCK_URL=https://ucp-mock.fxp007.workers.dev

# ── 用友宝供应商 API ──────────────────────────────────────────────────────────
# 留空时自动使用 mock 数据
YONYOU_BASE_URL=https://open.yonyoucloud.com
YONYOU_APP_ID=
YONYOU_APP_SECRET=

# ── Slack 通知 ────────────────────────────────────────────────────────────────
# 留空时降级到本地日志
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_OPS_CHANNEL=#vending-ops
SLACK_RESTOCK_CHANNEL=#vending-restock
SLACK_PAYMENT_CHANNEL=#vending-payments

# ── 员工福利 ──────────────────────────────────────────────────────────────────
WELFARE_DEFAULT_QUOTA_YUAN=50.0

# ── Supply Chain Mock ─────────────────────────────────────────────────────────
# 本地运行 supply-chain-mock/server.py 后填入；留空时 agent 跳过库存/采购功能
SUPPLY_CHAIN_URL=http://localhost:8091

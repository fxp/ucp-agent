{
  "name": "ucp-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "account_id": "0356d59ccdcff356bf3bbdb580bbaa60",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "services": [
